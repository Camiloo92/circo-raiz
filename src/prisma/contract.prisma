// use prisma-8
enum OrderType {
  DONATION
  KIT
}

enum OrderStatus {
  PENDING
  APPROVED
  DECLINED
  ERROR
  VOIDED
}

model Customer {
  id        Int                        @id @default(autoincrement())
  name      String
  email     String                     @unique
  phone     String?
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  orders    Order[]
}

model Order {
  id                 Int                        @id @default(autoincrement())
  reference          String                     @unique
  type               OrderType
  status             OrderStatus                @default(PENDING)
  currency           String                     @default("COP")
  totalAmountInCents Int

  customerId         Int
  customer           Customer                   @relation(fields:[customerId], references:[id])

  items              OrderItem[]
  payment            Payment?
  shippingAddress    ShippingAddress?

  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()

  @@index([customerId, createdAt])
  @@index([status])
  @@index([createdAt])

  @@check(expression: "totalAmountInCents >= 0", name: "order_total_amount_non_negative")
}

model OrderItem {
  id                 Int    @id @default(autoincrement())
  orderId            Int
  kitId              String
  quantity           Int
  unitAmountInCents  Int
  totalAmountInCents Int

  order              Order  @relation(fields:[orderId], references:[id])

  @@index([orderId])

  @@check(expression: "quantity > 0", name: "order_item_quantity_positive")

  @@check(expression: "unitAmountInCents >= 0", name: "order_item_unit_amount_non_negative")

  @@check(expression: "totalAmountInCents >= 0", name: "order_item_total_amount_non_negative")
}

model Payment {
  id                 Int                        @id @default(autoincrement())
  orderId            Int                        @unique
  wompiTransactionId String                     @unique
  wompiEventId       String                     @unique
  status             String
  paymentMethod      String?
  paidAmountInCents  Int?

  order              Order                      @relation(fields:[orderId], references:[id])

  createdAt          TimestamptzString          @default(now())
  updatedAt          temporal.updatedAtString()

  @@index([status])
  @@index([createdAt])

  @@check(expression: "paidAmountInCents >= 0", name: "payment_paid_amount_non_negative")
}

model ShippingAddress {
  id            Int                        @id @default(autoincrement())
  orderId       Int                        @unique
  recipientName String
  phone         String
  address       String
  city          String
  department    String
  postalCode    String?

  order         Order                      @relation(fields:[orderId], references:[id])

  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()
}
